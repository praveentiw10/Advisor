        async function loadTransactions() {
            try {
                const res = await fetch('/api/transactions', { credentials: 'include' });
                const data = await res.json();
                const tbody = document.getElementById('transactions-tbody');
                if (!tbody) return;
                if (!data.success || !data.transactions || data.transactions.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="padding:40px 20px;text-align:center;color:var(--text-muted);">No deposits or withdrawals yet.</td></tr>';
                } else {
                    const fmt = (n) => '$' + (n || 0).toLocaleString(undefined, { minimumFractionDigits: 2 });
                    tbody.innerHTML = data.transactions.slice(0, 10).map(t => {
                        const date = new Date(t.createdAt).toLocaleDateString();
                        const color = t.type === 'DEPOSIT' ? 'var(--green)' : 'var(--red)';
                        const statusColor = t.status === 'COMPLETED' ? 'var(--green)' : t.status === 'FAILED' ? 'var(--red)' : '#fbbf24';
                        const recipientInfo = t.recipient || t.details;
                        const recipientDisplay = (t.type === 'WITHDRAWAL' && t.method !== 'UPI' && recipientInfo && recipientInfo.length > 6) ? '****' + recipientInfo.slice(-4) : (recipientInfo || '—');
