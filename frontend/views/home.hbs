        function scrollWatchlist(direction) {
            const grid = document.getElementById('watchlist-grid');
            const scrollAmount = 340; // Card width + gap
            grid.scrollBy({
                left: direction * scrollAmount,
                behavior: 'smooth'
            });
            setTimeout(updateSliderButtons, 400);
        }

        function updateSliderButtons() {
            const grid = document.getElementById('watchlist-grid');
            const prevBtn = document.getElementById('watchlist-prev');
            const nextBtn = document.getElementById('watchlist-next');
            if (!grid || !prevBtn || !nextBtn) return;

            if (grid.scrollLeft <= 0) {
                prevBtn.classList.add('disabled');
            } else {
                prevBtn.classList.remove('disabled');
            }

            if (grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 5) {
                nextBtn.classList.add('disabled');
            } else {
                nextBtn.classList.remove('disabled');
            }
        }

        // Listen for manual scrolls
        document.getElementById('watchlist-grid')?.addEventListener('scroll', updateSliderButtons);

