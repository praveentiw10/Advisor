        async function getCompanyName(symbol) {
            if (companyNames[symbol]) return companyNames[symbol];
            try {
                const sym = symbol === 'BTC' ? 'BINANCE:BTCUSDT' : symbol;
                const res = await fetch('/api/company-profile/' + sym, { credentials: 'include' });
                const data = await res.json();
                const name = data.name || data.ticker || symbol;
                companyNames[symbol] = name;
                return name;
            } catch (e) { return symbol; }
        }

