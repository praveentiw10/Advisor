        let currentReceipt = null;
        function showReceipt(receipt) {
            if (!receipt) return;
            currentReceipt = receipt;
            const fmt = (n) => '$' + (n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const isDeposit = receipt.type === 'DEPOSIT';
            document.getElementById('receipt-title').textContent = isDeposit ? 'Deposit Confirmed!' : 'Withdrawal Submitted!';
            document.getElementById('receipt-subtitle').textContent = isDeposit ? 'Funds have been credited to your account' : 'Processing in 1–3 business days';
            document.getElementById('receipt-ref').textContent = (receipt.referenceId || receipt.id || '').toString().toUpperCase();
            document.getElementById('receipt-date').textContent = new Date(receipt.date).toLocaleString();
            document.getElementById('receipt-type').textContent = receipt.type;
            document.getElementById('receipt-type').style.color = isDeposit ? 'var(--green)' : 'var(--red)';
            document.getElementById('receipt-amount').textContent = (isDeposit ? '+' : '-') + fmt(receipt.amount);
            document.getElementById('receipt-amount').style.color = isDeposit ? 'var(--green)' : 'var(--red)';
            document.getElementById('receipt-method').textContent = receipt.method || '—';
            document.getElementById('receipt-recipient').textContent = receipt.recipient || '—';
            const statusEl = document.getElementById('receipt-status');
            statusEl.textContent = receipt.status || 'COMPLETED';
            statusEl.className = 'status-pill ' + ((receipt.status || '').toLowerCase());
            document.getElementById('receipt-balance').textContent = fmt(receipt.newBalance);
            document.getElementById('pp-success-overlay').classList.add('show');
        }
        function showPPSuccess(amount, newBalance, receipt) {
            if (receipt) showReceipt(receipt);
            else showReceipt({ type: 'DEPOSIT', amount, newBalance, method: 'PAYPAL', recipient: 'PayPal', status: 'COMPLETED', date: new Date(), referenceId: 'PAYPAL', id: '' });
        }
        function printReceipt() {
            const el = document.getElementById('receipt-content');
            if (!el) return;
            const win = window.open('', '_blank');
            win.document.write('<html><head><title>Payment Receipt - ADVISOR</title><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"><style>body{font-family:Inter,sans-serif;background:#020617;color:#f8fafc;padding:40px;max-width:500px;margin:0 auto;} table{width:100%;border-collapse:collapse;} td{padding:10px 0;} .muted{color:#94a3b8;} .amt{font-size:24px;font-weight:900;}</style></head><body><h2>ADVISOR - Payment Receipt</h2>' + el.outerHTML + '<p style="margin-top:24px;font-size:11px;color:#64748b;">Generated ' + new Date().toLocaleString() + '</p></body></html>');
            win.document.close();
            win.print();
            win.close();
        }
        function downloadReceipt() {
            if (typeof html2pdf === 'undefined') { showToast('warn', 'PDF', 'PDF library loading. Please try again.'); return; }
