        let searchTimer = null;
        (function initSearch() {
            const inp = document.getElementById('stock-search');
            const resDiv = document.getElementById('search-results');
            if (inp) {
                inp.addEventListener('input', function () {
                    clearTimeout(searchTimer);
                    const q = inp.value.trim();
                    if (q.length < 2) { resDiv.style.display = 'none'; return; }
                    searchTimer = setTimeout(async () => {
                        try {
                            const r = await fetch('/api/search?q=' + encodeURIComponent(q), { credentials: 'include' });
                            const d = await r.json();
                            const results = (d.result || []).filter(r => (r.symbol && (r.type === 'Common Stock' || r.type === 'ETF' || r.type === 'EQS' || !r.type))).slice(0, 10);
                            if (results.length) {
                                resDiv.innerHTML = results.map(r => {
                                    const sym = (r.symbol || r.displaySymbol || '').trim();
                                    const desc = (r.description || r.displaySymbol || sym || '').trim();
                                    return '<div data-symbol="' + sym + '">' + desc + ' (' + sym + ')</div>';
                                }).join('');
                                resDiv.style.display = 'block';
                                resDiv.querySelectorAll('div').forEach(el => {
                                    el.onclick = async () => {
                                        const sym = (el.getAttribute('data-symbol') || '').trim().toUpperCase();
                                        if (!sym) return;
                                        resDiv.style.display = 'none';
                                        inp.value = '';
                                        try {
                                            await fetch('/api/watchlist', { method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'include', body: JSON.stringify({ symbol: sym }) });
                                            loadWatchlist();
                                        } catch (e) { }
                                    };
                                });
                            } else resDiv.style.display = 'none';
                        } catch (e) { resDiv.style.display = 'none'; }
                    }, 300);
                });
                document.addEventListener('click', () => { resDiv.style.display = 'none'; });
            }
        })();

        async function loadNews(symbol) {
            const el = document.getElementById('news-list');
            if (!el) return;
            try {
                const fetchSym = (symbol === 'BTC' || symbol === 'ETH') ? '' : (symbol || '');
                const url = fetchSym ? '/api/news?symbol=' + encodeURIComponent(fetchSym) : '/api/news';
                const res = await fetch(url, { credentials: 'include' });
                const data = await res.json();
                const news = data.news || [];
                if (!news.length) { el.innerHTML = '<p style="color:var(--text-muted); font-size:13px;">No news available.</p>'; return; }
                el.innerHTML = news.slice(0, 8).map(n => {
                    const date = n.datetime ? new Date(n.datetime * 1000).toLocaleDateString() : '';
                    return '<div class="news-card"><a href="' + (n.url || '#') + '" target="_blank" rel="noopener">' + (n.headline || n.title || 'No title') + '</a><div class="news-source">' + (n.source || '') + ' • ' + date + '</div></div>';
                }).join('');
            } catch (e) { el.innerHTML = '<p style="color:var(--text-muted); font-size:13px;">Could not load news.</p>'; }
        }

