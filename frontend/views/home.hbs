        // ═══════════════════════════════════════════════
        function onWithdrawMethodChange() {
            const m = document.getElementById('dashboard-withdraw-method').value;
            const label = document.getElementById('withdraw-info-label');
            const inp = document.getElementById('dashboard-withdraw-details');
            if (m === 'UPI') { label.innerText = 'UPI ID'; inp.placeholder = 'example@upi'; }
            else if (m === 'CARD') { label.innerText = 'Card Number'; inp.placeholder = 'XXXX XXXX XXXX XXXX'; }
            else { label.innerText = 'Bank / SWIFT'; inp.placeholder = 'Full bank details'; }
        }

        async function submitDashboardWithdrawal() {
            const amount = parseFloat(document.getElementById('dashboard-withdraw-input').value);
            const method = document.getElementById('dashboard-withdraw-method').value;
            const details = document.getElementById('dashboard-withdraw-details').value.trim();
            const btn = document.querySelector('#subpage-withdraw button[onclick]');

            if (!amount || amount < 10) {
                showToast('warn', 'Minimum Amount', 'The minimum withdrawal is $10.00.');
                return;
            }
            if (!details) {
                showToast('warn', 'Missing Details', 'Please enter your recipient details.');
                return;
            }

            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin" style="margin-right:8px;"></i>SUBMITTING…'; }
            try {
                const res = await fetch('/withdraw', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ amount, method, details })
                });
                const d = await res.json();
                if (d.success) {
                    if (d.receipt) showReceipt(d.receipt);
                    else showToast('success', 'Withdrawal Submitted 🏦', `$${amount.toLocaleString('en-US', { minimumFractionDigits: 2 })} via ${method} is being processed in 1–3 business days.`, 7000);
                    document.getElementById('dashboard-withdraw-input').value = '';
                    document.getElementById('dashboard-withdraw-details').value = '';
                    loadFundsData();
                    loadPortfolio();
                    loadTransactions();
                    refreshNotifications();
                } else {
                    showToast('error', 'Withdrawal Failed', d.message || 'Please try again.');
                }
            } catch (e) {
                showToast('error', 'Network Error', 'Could not reach the server. Check your connection.');
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-paper-plane" style="margin-right:8px;"></i>CONFIRM WITHDRAWAL'; }
            }
        }
    </script>
</body>

</html>