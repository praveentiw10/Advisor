    <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>

        let symbols = ['AAPL', 'TSLA', 'NVDA', 'MSFT', 'GOOGL', 'AMZN', 'META', 'NFLX', 'BTC'];
        const indices = ['SPY', 'QQQ', 'DIA'];
        let companyNames = {};
        let chartWidgetTerminal = null;

        function getPriceColor(change) {
            if (change >= 2) return 'var(--green-dark)';
            if (change > 0) return 'var(--green)';
            if (change <= -2) return 'var(--red-dark)';
            if (change < 0) return 'var(--red)';
            return 'var(--text-muted)';
        }

        function getMarketStatus() {
            var now = new Date();
            var et = new Date(now.toLocaleString('en-US', { timeZone: 'America/New_York' }));
            var day = et.getDay();
            var h = et.getHours();
            var m = et.getMinutes();
            var mins = h * 60 + m;
            if (day === 0 || day === 6) return { text: 'Closed', live: false };
            if (mins < 4 * 60 + 0) return { text: 'Pre-Market', live: true };
            if (mins < 9 * 60 + 30) return { text: 'Pre-Market', live: true };
            if (mins < 16 * 60 + 0) return { text: 'Open', live: true };
            if (mins < 20 * 60 + 0) return { text: 'After-Hours', live: true };
            return { text: 'Closed', live: false };
        }

        function updateMarketStatus() {
            var st = getMarketStatus();
            var el = document.getElementById('market-status');
            if (el) el.textContent = st.text;
            var summaryEl = document.getElementById('summary-market-status');
            if (summaryEl) summaryEl.textContent = st.text;
        }

        function updateLastUpdated() {
            var t = new Date();
            var s = t.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            var h = document.getElementById('last-updated-header');
            if (h) h.textContent = ' • Updated: ' + s;
        }

        function setDynamicDates() {
            var d = new Date();
            var dateStr = d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
            var timeStr = d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
            var taxEl = document.getElementById('tax-generated-date');
            if (taxEl) taxEl.textContent = dateStr;
            var syncEl = document.getElementById('settings-last-sync');
            if (syncEl) syncEl.textContent = dateStr + ', ' + timeStr;
            var sessionEl = document.getElementById('settings-session-started');
            if (sessionEl) sessionEl.textContent = dateStr + ', ' + timeStr;
            var histEl = document.getElementById('history-report-generated');
            if (histEl) histEl.textContent = dateStr;
        }

        // Load user info and show welcome message when coming from signup
        (function () {
            const user = JSON.parse(localStorage.getItem('user') || sessionStorage.getItem('user') || '{}');
            const serverName = (document.body.getAttribute('data-user-name') || '').trim();
            const userName = user.name || serverName;
            if (userName) {
                document.getElementById('user-name-sidebar').innerText = userName;
                document.getElementById('user-name-welcome').innerText = userName;
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('welcome') === '1') {
                    const banner = document.getElementById('welcome-banner');
                    const titleEl = document.getElementById('welcome-banner-title');
                    const textEl = document.getElementById('welcome-banner-text');
                    if (banner && titleEl) {
                        titleEl.textContent = 'Welcome, ' + userName + '!';
                        if (textEl) textEl.textContent = 'Your account is ready. Start exploring the terminal.';
                        banner.style.display = 'block';
                    }
                    if (window.history.replaceState) {
                        window.history.replaceState({}, document.title, window.location.pathname);
                    }
                }
            } else {
                window.location.href = '/login';
            }
        })();

        function dismissWelcomeBanner() {
            const banner = document.getElementById('welcome-banner');
            if (banner) banner.style.display = 'none';
        }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            sessionStorage.removeItem('token');
            sessionStorage.removeItem('user');
        }


        function showPage(pageId, element) {

            document.querySelectorAll('.nav li').forEach(li => li.classList.remove('active'));
            element.classList.add('active');


            document.querySelectorAll('.page-content').forEach(page => page.classList.remove('active'));
            document.getElementById(pageId + '-page').classList.add('active');


            const titles = { 'overview': 'Portfolio Analytics', 'market': 'Live Market Terminal', 'portfolios': 'Active Holdings', 'history': 'Trade History', 'tax': 'Tax Center', 'settings': 'System Settings', 'funds': 'Deposit & Withdraw' };
            document.getElementById('page-title').innerText = titles[pageId];

            if (pageId === 'portfolios') {
                loadPortfolio();
                loadTransactions();
            }
            if (pageId === 'funds') {
                onDepositMethodChange();
                initPayPalInDashboard();
                loadFundsData();
            }
            if (pageId === 'history') loadOrders();
            if (pageId === 'tax') loadTaxSummary();

            if (window.innerWidth <= 768) toggleSidebar();
        }

        let tradeModalSymbol = '';
        let tradeModalSide = '';
        let tradeModalPrice = 0;

        function openTradeModal(symbol, side) {
            tradeModalSymbol = symbol;
            tradeModalSide = side.toUpperCase();
            const fetchSym = symbol === 'BTC' ? 'BINANCE:BTCUSDT' : symbol;
            document.getElementById('trade-modal-symbol').textContent = symbol;
            document.getElementById('trade-modal-price').textContent = 'Loading...';
            document.getElementById('trade-modal-qty').value = '';
            document.getElementById('trade-modal-title').textContent = side === 'BUY' ? 'Buy ' + symbol : 'Sell ' + symbol;
            document.getElementById('trade-modal-buy-btn').style.display = tradeModalSide === 'BUY' ? 'block' : 'none';
            document.getElementById('trade-modal-sell-btn').style.display = tradeModalSide === 'SELL' ? 'block' : 'none';
            document.getElementById('trade-modal').classList.add('open');
            fetch('/api/stock/' + fetchSym, { credentials: 'include' })
                .then(r => r.json())
                .then(data => {
                    if (data.c != null) {
                        tradeModalPrice = data.c;
                        document.getElementById('trade-modal-price').textContent = '$' + data.c.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    } else {
                        document.getElementById('trade-modal-price').textContent = '—';
                    }
                })
                .catch(() => { document.getElementById('trade-modal-price').textContent = '—'; });
        }

        function closeTradeModal() {
            document.getElementById('trade-modal').classList.remove('open');
        }

        async function placeTrade(side) {
            const qty = parseInt(document.getElementById('trade-modal-qty').value, 10);
            if (!qty || qty < 1) {
                alert('Enter a valid quantity.');
                return;
            }
            const btn = side === 'BUY' ? document.getElementById('trade-modal-buy-btn') : document.getElementById('trade-modal-sell-btn');
            btn.disabled = true;
            btn.textContent = 'Processing...';
            try {
                const res = await fetch('/api/trade', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ symbol: tradeModalSymbol, side, quantity: qty })
                });
                const data = await res.json();
                if (data.success) {
                    closeTradeModal();
                    alert(data.message);
                    loadPortfolio();
                    loadOrders();
                } else {
                    alert(data.message || 'Trade failed.');
                }
            } catch (e) {
                alert('Network error. Please try again.');
            }
            btn.disabled = false;
            btn.textContent = side === 'BUY' ? 'Buy' : 'Sell';
        }

        async function loadPortfolio() {
            try {
                const res = await fetch('/api/portfolio', { credentials: 'include' });
                const data = await res.json();
                if (!data.success || !data.portfolio) return;
                const p = data.portfolio;
                const fmt = (n) => '$' + (n || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                document.getElementById('portfolio-total-value').textContent = fmt(p.portfolioValue);
                document.getElementById('portfolio-cash').textContent = fmt(p.cashBalance);
                document.getElementById('portfolio-invested').textContent = fmt(p.totalInvested);
                const pnlEl = document.getElementById('portfolio-pnl');
                const pnl = p.unrealizedPnl ?? 0;
                pnlEl.textContent = (pnl >= 0 ? '+' : '') + fmt(pnl) + (p.unrealizedPnlPercent != null ? ' (' + (p.unrealizedPnlPercent >= 0 ? '+' : '') + p.unrealizedPnlPercent.toFixed(2) + '%)' : '');
                pnlEl.style.color = pnl >= 0 ? 'var(--green)' : 'var(--red)';
                const tbody = document.getElementById('holdings-tbody');
                if (!p.holdings || p.holdings.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" style="padding:40px 20px;text-align:center;color:var(--text-muted);">No positions yet. Buy stocks from the Overview watchlist.</td></tr>';
                } else {
                    tbody.innerHTML = p.holdings.map(h => {
                        const change = h.pnlPercent || 0;
                        const c = getPriceColor(change);
                        return '<tr><td style="padding:10px;"><a href="/symbol/' + h.symbol + '" style="color:var(--accent);text-decoration:none;font-weight:700;">' + h.symbol + '</a></td><td style="padding:10px;text-align:right;">' + h.quantity + '</td><td style="padding:10px;text-align:right;">' + fmt(h.avgCost) + '</td><td style="padding:10px;text-align:right;">' + fmt(h.ltp) + '</td><td style="padding:10px;text-align:right;">' + fmt(h.value) + '</td><td style="padding:10px;text-align:right;color:' + c + '">' + (h.pnl >= 0 ? '+' : '') + fmt(h.pnl) + ' (' + (h.pnlPercent >= 0 ? '+' : '') + (h.pnlPercent || 0).toFixed(2) + '%)</td></tr>';
                    }).join('');
                }
                const allocEl = document.getElementById('asset-allocation-content');
                if (p.holdings && p.holdings.length > 0 && p.portfolioValue > 0) {
                    allocEl.innerHTML = p.holdings.map(h => {
                        const pct = ((h.value / p.portfolioValue) * 100).toFixed(1);
                        return '<div style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;"><span>' + h.symbol + '</span><span style="font-weight:700;">' + pct + '%</span></div>';
                    }).join('');
                    allocEl.style.textAlign = 'left';
                    allocEl.style.padding = '20px';
                } else {
                    allocEl.textContent = 'No allocation data yet. Buy stocks to see your allocation.';
                    allocEl.style.textAlign = 'center';
                }
            } catch (e) { }
        }

