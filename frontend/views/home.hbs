        // ═══════════════════════════════════════════════
        //  PAYPAL BUTTON INIT
        // ═══════════════════════════════════════════════
        let paypalInited = false;
        function initPayPalInDashboard() {
            if (paypalInited) return;
            if (typeof paypal === 'undefined') {
                console.warn('PayPal SDK not loaded yet');
                return;
            }
            paypal.Buttons({
                style: {
                    layout: 'vertical',
                    color: 'gold',
                    shape: 'rect',
                    label: 'pay',
                    height: 50
                },
                createOrder: async (data, actions) => {
                    const amt = parseFloat(document.getElementById('dashboard-deposit-input').value);
                    if (!amt || amt <= 0) {
                        showToast('warn', 'Invalid Amount', 'Please enter a valid deposit amount.');
                        return Promise.reject(new Error('Invalid amount'));
                    }
                    const res = await fetch('/create-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ amount: amt })
                    });
                    const o = await res.json();
                    if (!o.id) throw new Error(o.message || 'Order creation failed');
                    return o.id;
                },
                onApprove: async (data, actions) => {
                    showToast('info', 'Processing Payment…', 'Please wait while we confirm your deposit.');
                    const res = await fetch('/capture-order', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        credentials: 'include',
                        body: JSON.stringify({ orderID: data.orderID })
                    });
                    const d = await res.json();
                    if (d.success) {
                        showPPSuccess(
                            parseFloat(document.getElementById('dashboard-deposit-input').value),
                            d.newBalance,
                            d.receipt
                        );
                        loadFundsData();
                        refreshNotifications();
                    } else {
                        showToast('error', 'Deposit Failed', d.message || 'PayPal could not complete the payment.');
                    }
                },
                onError: (err) => {
                    console.error('PayPal error:', err);
                    showToast('error', 'PayPal Error', 'Something went wrong. Please try again.');
                },
                onCancel: () => {
                    showToast('info', 'Payment Cancelled', 'You cancelled the PayPal checkout.');
                }
            }).render('#paypal-button-dashboard');
            paypalInited = true;
        }

        // ═══════════════════════════════════════════════
        //  IN-APP NOTIFICATION BELL
        // ═══════════════════════════════════════════════
        let notifPanelOpen = false;
        function toggleNotifPanel() { notifPanelOpen ? closeNotifPanel() : openNotifPanel(); }
        function openNotifPanel() {
            notifPanelOpen = true;
            document.getElementById('notif-panel').classList.add('open');
            document.getElementById('notif-panel-overlay').classList.add('open');
            loadNotifications();
        }
        function closeNotifPanel() {
            notifPanelOpen = false;
            document.getElementById('notif-panel').classList.remove('open');
            document.getElementById('notif-panel-overlay').classList.remove('open');
        }
        function timeAgo(dateStr) {
            const diff = (Date.now() - new Date(dateStr)) / 1000;
            if (diff < 60) return 'Just now';
            if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
            if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
            return Math.floor(diff / 86400) + 'd ago';
        }
        function getNotifIconClass(type) {
            if (type === 'DEPOSIT') return 'notif-icon-deposit';
            if (type === 'WITHDRAWAL') return 'notif-icon-withdrawal';
            return 'notif-icon-default';
        }
        async function loadNotifications() {
            try {
                const res = await fetch('/api/notifications', { credentials: 'include' });
                const data = await res.json();
                if (!data.success) return;
                const list = document.getElementById('notif-list');
                const badge = document.getElementById('notif-badge');
                const countLabel = document.getElementById('notif-count-label');
                const markAllBtn = document.getElementById('notif-mark-all-btn');
                if (data.unreadCount > 0) {
                    badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                    badge.style.display = 'flex';
                    markAllBtn.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                    markAllBtn.style.display = 'none';
                }
                countLabel.textContent = data.notifications.length ? `(${data.notifications.length})` : '';
                if (!data.notifications.length) {
                    list.innerHTML = `<div class="notif-empty"><i class="fa-solid fa-bell-slash"></i><p>No notifications yet</p></div>`;
                    return;
                }

                // Helper to fix older/broken icons in the list
                const fixIcon = (icon) => {
                    if (!icon || icon === 'fa-money-bill-transfer') return 'fa-wallet';
                    if (icon === 'fa-hand-holding-dollar') return 'fa-building-columns';
                    return icon;
                };

                list.innerHTML = data.notifications.map(n => {
                    const iconClass = fixIcon(n.icon);
                    return `
                    <div class="notif-item ${n.read ? '' : 'unread'}" data-id="${n._id}" onclick="markOneRead('${n._id}', this)">
                        <div class="notif-icon-wrap ${getNotifIconClass(n.type)}">
                            <i class="fa-solid ${iconClass}" style="font-size: 20px; filter: drop-shadow(0 0 8px currentColor);"></i>
                        </div>
                        <div class="notif-body">
                            <div class="notif-title">${n.title}</div>
                            <div class="notif-msg">${n.message}</div>
                        </div>
                        <div class="notif-time">${timeAgo(n.createdAt)}</div>
                    </div>`;
                }).join('');
            } catch (e) { console.error('Notification load error:', e); }
        }
        async function markOneRead(id, el) {
            if (!el.classList.contains('unread')) return;
            el.classList.remove('unread');
            try { await fetch(`/api/notifications/${id}/read`, { method: 'PATCH', credentials: 'include' }); refreshNotifications(); } catch (e) { }
        }
        async function markAllRead() {
            try { await fetch('/api/notifications/read-all', { method: 'PATCH', credentials: 'include' }); loadNotifications(); } catch (e) { }
        }
        async function refreshNotifications() {
            try {
                const res = await fetch('/api/notifications', { credentials: 'include' });
                const data = await res.json();
                if (!data.success) return;
                const badge = document.getElementById('notif-badge');
                const markAllBtn = document.getElementById('notif-mark-all-btn');
                if (data.unreadCount > 0) {
                    badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                    badge.style.display = 'flex';
                    markAllBtn.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                    markAllBtn.style.display = 'none';
                }
                if (notifPanelOpen) loadNotifications();
            } catch (e) { }
        }
        refreshNotifications();
        setInterval(refreshNotifications, 30000);

