        async function handleDashboardUPIDeposit() {
            const amt = parseFloat(document.getElementById('dashboard-deposit-input').value);
            const upiId = document.getElementById('dashboard-deposit-upi-id').value.trim();

            if (!amt || amt < 10) {
                showToast('warn', 'Invalid Amount', 'Minimum deposit is $10.');
                return;
            }
            if (!upiId) {
                showToast('warn', 'Missing UPI ID', 'Please enter your UPI ID.');
                return;
            }

            const btn = document.getElementById('upi-deposit-btn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';

            try {
                const res = await fetch('/api/payment/upi-deposit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ amount: amt, upiId: upiId })
                });
                const data = await res.json();
                if (data.success) {
                    if (data.receipt) showReceipt(data.receipt);
                    else showToast('success', 'Request Sent', 'Your UPI deposit request is being processed. It will be credited soon.');
                    loadFundsData();
                    refreshNotifications();
                    document.getElementById('dashboard-deposit-upi-id').value = '';
                } else {
                    showToast('error', 'Request Failed', data.message || 'Could not initiate UPI deposit.');
                }
            } catch (e) {
                showToast('error', 'Network Error', 'Something went wrong. Please try again.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-circle-check"></i> CONFIRM DEPOSIT';
            }
        }


